{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "issues": "https://github.com/osad-sakana/utilitiesforprogrammers/issues"
    },
    "license": "${mod_license}",
    "icon": "pack.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "osadsakana.utilitiesforprogrammers.UtilitiesForProgrammers"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "=${minecraft_version}",
        "java": ">=25",
        "fabric-api": ">=0.158.0"
    }
}
